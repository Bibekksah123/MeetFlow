{
  "name": "meetflow",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@meetflow/web --filter=@meetflow/worker",
    "build": "turbo build",
    "start": "turbo start --filter=@meetflow/web --filter=@meetflow/worker",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "turbo run db:generate --filter=@meetflow/db",
    "db:migrate": "turbo run db:migrate --filter=@meetflow/db",
    "db:verify": "turbo run db:verify --filter=@meetflow/db",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "eslint": "9",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.5",
    "typescript": "5.9",
    "vitest": "5.0.2"
  }
}
