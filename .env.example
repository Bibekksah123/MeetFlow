# Supabase Auth settings can live in apps/web/.env.local.
# The Next.js server and database tooling also load DATABASE_URL from the repository root .env.local.
# Supabase Auth and database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiveKit (required for live meetings; API credentials are server-only)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini (required by the meeting processing worker; key stays server-side)
GEMINI_API_KEY=

# n8n webhook for approved Notion tasks (server-only)
N8N_TASK_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Supabase Storage S3 output for LiveKit Egress (server-only; keep the bucket private)
RECORDING_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
RECORDING_S3_REGION=<project-region>
RECORDING_S3_BUCKET=<private-bucket-name>
RECORDING_S3_ACCESS_KEY=<server-side-access-key>
RECORDING_S3_SECRET_KEY=<server-side-secret>
